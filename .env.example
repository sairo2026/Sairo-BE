# 로컬 개발 환경변수 템플릿. 복사해서 .env로 저장하고 각자 로컬 값으로 채운다.
# .env는 git에 올라가지 않는다(.gitignore 참고). 이 파일에는 실제 비밀번호를 넣지 않는다.

SPRING_PROFILES_ACTIVE=local

LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=sairo
LOCAL_DB_USERNAME=sairo_local
LOCAL_DB_PASSWORD=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI_LOCAL=http://localhost:8080/api/auth/kakao/callback

FRONTEND_BASE_URL=http://localhost:3000
